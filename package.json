    "test:my-profiles:complete:verbose": "k6 run tests/forms/my-profiles-complete.js --summary-export=my-profiles-results.json",
    
    "test:api": "k6 run tests/api/**/*.test.js",
    "test:api:auth": "k6 run tests/api/auth/*.test.js",
    "test:api:favorites": "k6 run tests/api/favorites/*.test.js",
    "test:api:messages": "k6 run tests/api/messages/*.test.js",
    "test:api:monetization": "k6 run tests/api/monetization/**/*.test.js",
    "test:api:monetization:contacts": "k6 run tests/api/monetization/contacts/*.test.js",
    "test:api:monetization:credits": "k6 run tests/api/monetization/credits/*.test.js",
    "test:api:monetization:promotions": "k6 run tests/api/monetization/promotions/*.test.js",
    "test:api:profiles:delete": "k6 run tests/api/profiles/delete/*.test.js",
    "test:api:reviews": "k6 run tests/api/reviews/*.test.js",
    "test:api:applications": "k6 run tests/api/applications/*.test.js",
    "test:api:subscriptions": "k6 run tests/api/subscriptions/*.test.js",
    "test:api:user": "k6 run tests/api/user/*.test.js",
    "test:api:billing": "k6 run tests/api/billing/*.test.js",
    "test:api:media": "k6 run tests/api/media/*.test.js",
    "test:api:search": "k6 run tests/api/search/*.test.js",
    "test:api:feed": "k6 run tests/api/feed/*.test.js",
    
    "test:integration": "k6 run tests/integration/*.test.js",
    "test:security": "k6 run tests/security/*.test.js",
    "test:performance": "k6 run tests/performance/*.test.js",
    "test:chaos": "k6 run tests/chaos/*.test.js",
    
    "test:all-sequential": "powershell -ExecutionPolicy Bypass -File scripts/run-all-tests.ps1",
    "report:html": "node scripts/generate-html-report.js",
    "test:full": "npm run test:all-sequential && npm run report:html"
