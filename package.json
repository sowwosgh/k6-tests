{
  "name": "k6-tests",
  "version": "1.0.0",
  "description": "Performance tests for HR platform",
  "scripts": {
    "test:smoke": "k6 run tests/smoke/api-health.js",
    "test:load": "k6 run tests/load/feed-load.js",
    "test:stress": "k6 run tests/stress/feed-stress.js",
    "test:scenarios": "k6 run tests/scenarios/user-journey.js",
    "test:all": "powershell -File scripts/run-all-tests.ps1",
    "test:registration": "k6 run tests/scenarios/registration-flow.js",
    "test:payments": "k6 run tests/scenarios/payment-flow.js",
    "test:messages": "k6 run tests/scenarios/messaging-flow.js",
    
    "auth:token": "powershell -File scripts/get-auth-token.ps1",
    "auth:token:node": "node scripts/get-auth-token.js",
    
    "test:forms": "k6 run tests/forms/all-forms.js",
    "test:forms:smoke": "k6 run --vus 1 --iterations 1 tests/forms/all-forms.js",
